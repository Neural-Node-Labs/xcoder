# xcoder — environment configuration
# Copy this file to .env and fill in what you need. Nothing here is required to start:
# xcoder requires a PostgreSQL database (see the Database section below) and works with no
# LLM key configured (it will just fail loudly and clearly when you try to run a task without one).

# ─── LLM provider keys ──────────────────────────────────────────────────────────
# Set whichever key(s) match the provider(s) in agent/config/llm.yaml. Local providers like
# Ollama need no key at all — see NO_AUTH_PROVIDERS in src/config/loadConfig.ts.
DEEPSEEK_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-your-key-here
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=sk-your-key-here
# OLLAMA_API_KEY=   # only needed if your local Ollama sits behind an authenticated proxy

# ─── xcoder home / workspace resolution ────────────────────────────────────────
# Where xcoder looks for agent/config/llm.yaml and agent/xcoder.md-equivalent (xcoder.md)
# when they aren't found in the current directory. See src/config/paths.ts.
# XCODER_HOME=

# Root directory under which all xcoder-managed project workspaces are created (see
# src/api/projectStore.ts). Defaults to ~/.xcoder/projects.
# XCODER_PROJECTS_ROOT=

# When set, refuses to operate on any path outside XCODER_PROJECTS_ROOT.
# XCODER_RESTRICT_TO_WORKSPACE=true

# ─── HTTP API server ────────────────────────────────────────────────────────────
XCODER_API_HOST=0.0.0.0
XCODER_API_PORT=3001
# PORT=3001   # honored as a fallback if XCODER_API_PORT is unset

# Run against a simulated LLM connection instead of a real provider — no API key needed, no
# real network calls made. Same effect as the CLI's --mock flag, but for the long-running API
# server (so xcoder --serve --mock / --ui --mock also works without setting this by hand).
# XCODER_MOCK_LLM=true

# ─── Production security (see the security review notes before a SaaS launch) ──
# Comma-separated allowlist of origins allowed to make cross-origin requests to this API. With
# nothing set, cross-origin requests are refused entirely (same-origin only) — the API no
# longer defaults to a wildcard CORS policy.
# XCODER_CORS_ORIGIN=https://app.example.com,https://staging.example.com

# How long an issued auth token stays valid, in ms. Default: 7 days.
# XCODER_TOKEN_TTL_MS=604800000

# Per-user task submission rate limit (protects against one tenant exhausting LLM cost/server
# resources at another tenant's expense). Defaults: 30 task submissions per hour per user.
# XCODER_TASK_RATE_MAX=30
# XCODER_TASK_RATE_WINDOW_MS=3600000

# Disables run_command_tool and every ssh_*/docker_* tool at the dispatch layer, server-wide.
# Set this unless you have real per-tenant sandboxing (a container/microVM per task) in front
# of this deployment — see the security review notes for why these tools cannot be safely
# offered to untrusted multi-tenant users without infrastructure-level isolation.
# XCODER_DISABLE_SHELL_TOOLS=true

# Disables outbound-network tools (playwright, crawling, URL summarization, API testing,
# GitHub) at the dispatch layer, server-wide. Reduces SSRF exposure (e.g. requests to cloud
# metadata endpoints) from a task's tool calls.
# XCODER_DISABLE_NETWORK_TOOLS=true

# Forces read_tool/write_edit_tool to stay inside the resolved project workspace. Already
# defaults to "true" automatically for the API server (see src/api/server.ts) unless you set
# this explicitly yourself; the CLI's own default remains off, since a local single-user
# invocation often has legitimate reasons to read outside the current directory.
# XCODER_RESTRICT_TO_WORKSPACE=true

# ─── Database (required — PostgreSQL) ───────────────────────────────────────────
# Either set DATABASE_URL directly, or configure the individual DATABASE_HOST/PORT/etc.
# vars below. DATABASE_URL takes precedence when set.
DATABASE_URL=postgres://xcoder:xcoder_pass@localhost:5432/xcoder
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=xcoder
# DATABASE_USER=xcoder
# DATABASE_PASSWORD=xcoder_pass
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE=10000
# DATABASE_POOL_TIMEOUT=5000

# ─── Remote deploy (ssh_tool / ssh_copy_tool / --deploy --remote) ───────────────
# REMOTE_SSH_USER=
# REMOTE_SSH_PASSWORD=
# XCODER_SSH_TARGETS=          # comma-separated "host" or "host:port" list
# XCODER_SSH_USER=
# XCODER_SSH_PASSWORD=

# ─── git_tool commit identity (optional — falls back to the local git config) ──
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ─── GitHub tools ────────────────────────────────────────────────────────────
# GITHUB_TOKEN=

# ─── Sign in with Google (Users page + login screen) ───────────────────────────
# OAuth "Web application" client id from Google Cloud Console (APIs & Services >
# Credentials). Required for the "Sign in with Google" button to appear on the login
# screen and for admins to add Google-linked accounts under Users. Leave unset to disable
# Google sign-in entirely — GET /auth/google/config reports { enabled: false } and the UI
# hides the button.
# XCODER_GOOGLE_CLIENT_ID=

# ─── CodeGraph integration (Platform > Tools, codegraph_tool, /codegraph-ui) ────
# CodeGraph ships bundled with xcoder (integrations/codegraph/ — the API server, MCP server,
# and a pre-built Explorer UI) and is the default, zero-config path: run
#   npm run codegraph:install   # one-time — creates a venv, installs CodeGraph's Python deps
# then click "Start bundled CodeGraph" under Platform > Tools > Integrations. xcoder spawns it,
# authenticates automatically, and connects codegraph_tool — no URL or API key to type in.
# The variables below only matter for that bundled instance; you don't need to set any of them
# to get started (sane defaults are used).
# XCODER_CODEGRAPH_PORT=8877
# XCODER_CODEGRAPH_DATA_DIR=~/.xcoder/codegraph
# XCODER_CODEGRAPH_PYTHON=integrations/codegraph/codegraph/.venv/bin/python
#
# Prefer to run CodeGraph yourself instead (e.g. an existing shared deployment)? Skip
# "Start bundled CodeGraph" and use "Advanced: connect an external instance" on the same page,
# or set these to have it pre-filled without visiting the UI:
# XCODER_CODEGRAPH_URL=http://localhost:8000
# XCODER_CODEGRAPH_API_KEY=
# XCODER_CODEGRAPH_PROJECT_ID=

# ─── Misc ────────────────────────────────────────────────────────────────────
# MAX_ITERATIONS=25
# DEBUG=
