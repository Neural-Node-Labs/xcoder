/**
 * Regression suite for the tool implementations that src/tools/__tests__/toolDispatcher.regression.test.ts
 * exercises only through module-boundary mocks (since they need external binaries/network
 * that aren't available in CI). This file tests them directly:
 *
 *  - sshTool.ts: real integration against a closed local port (ssh2/password path — fast
 *    ECONNREFUSED, no mocking needed) plus mocked-spawn argument-building checks for the
 *    key-based shell-out path (since the `ssh`/`scp` binaries aren't installed here).
 *  - scheduleTool.ts: mocked `node:child_process` (no real `crontab` binary in CI) — verifies
 *    the exact crontab content built/parsed for add/list/remove, and the one-off scheduling
 *    command.
 *  - dockerComposeDeployTool.ts: real spawn against a project dir with no `docker` binary
 *    available — exercises the real ENOENT/spawn-error handling path.
 *  - sshCopyTool.ts / sshRunCommandTool.ts: real `connect()` against closed local ports —
 *    fan-out across multiple targets, per-target error isolation, and target filtering, all
 *    exercised for real without mocking ssh2.
 */
import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { EventEmitter } from "node:events";
import { RemoteConfig } from "../../remote/types.js";

let tmpDir: string;

beforeEach(() => {
  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "xcoder-tool-test-"));
});

afterEach(() => {
  fs.rmSync(tmpDir, { recursive: true, force: true });
});

// ─── sshTool.ts — real network path (password / ssh2) ─────────────────────────────────

describe("sshTool.sshExec — password (ssh2) path against an unreachable host", () => {
  it("fails fast with exitCode -1 instead of hanging for the default 60s timeout", async () => {
    const { sshExec } = await import("../sshTool.js");
    const start = Date.now();
    const result = await sshExec({ host: "127.0.0.1", port: 1, user: "nobody", password: "x" }, "echo hi");
    expect(result.exitCode).toBe(-1);
    expect(Date.now() - start).toBeLessThan(5000);
  }, 10000);
});

describe("sshTool.scpUpload / scpDownload — password (ssh2/SFTP) path against an unreachable host", () => {
  it("scpUpload reports failure instead of throwing", async () => {
    fs.writeFileSync(path.join(tmpDir, "f.txt"), "content");
    const { scpUpload } = await import("../sshTool.js");
    const result = await scpUpload({ host: "127.0.0.1", port: 1, user: "nobody", password: "x" }, path.join(tmpDir, "f.txt"), "/remote/f.txt");
    expect(result.exitCode).toBe(-1);
  }, 10000);

  it("scpDownload reports failure instead of throwing", async () => {
    const { scpDownload } = await import("../sshTool.js");
    const result = await scpDownload({ host: "127.0.0.1", port: 1, user: "nobody", password: "x" }, "/remote/f.txt", path.join(tmpDir, "out.txt"));
    expect(result.exitCode).toBe(-1);
  }, 10000);
});

// ─── sshTool.ts — key-based (shell-out) path, argument construction ──────────────────

describe("sshTool — key-based shell-out path (mocked spawn, argument construction)", () => {
  function makeFakeChild() {
    const child: any = new EventEmitter();
    child.stdout = new EventEmitter();
    child.stderr = new EventEmitter();
    return child;
  }

  it("sshExec without a password omits sshpass and sets BatchMode=yes", async () => {
    vi.resetModules();
    const spawnMock = vi.fn(() => {
      const child = makeFakeChild();
      queueMicrotask(() => child.emit("close", 0));
      return child;
    });
    vi.doMock("node:child_process", () => ({ spawn: spawnMock }));
    const { sshExec } = await import("../sshTool.js");

    await sshExec({ host: "example.com", user: "deploy", port: 2222, keyPath: "/home/me/.ssh/id_rsa" }, "uptime");

    expect(spawnMock).toHaveBeenCalledTimes(1);
    const [cmd, args] = spawnMock.mock.calls[0] as unknown as [string, string[]];
    expect(cmd).toBe("ssh");
    expect(args).toContain("-o");
    expect(args).toContain("BatchMode=yes");
    expect(args).toEqual(expect.arrayContaining(["-p", "2222", "-i", "/home/me/.ssh/id_rsa", "deploy@example.com", "uptime"]));
    vi.doUnmock("node:child_process");
    vi.resetModules();
  });

  it("sshExec with a password wraps the command with sshpass and passes SSHPASS via env, not argv", async () => {
    vi.resetModules();
    const spawnMock = vi.fn(() => {
      const child = makeFakeChild();
      queueMicrotask(() => child.emit("close", 0));
      return child;
    });
    vi.doMock("node:child_process", () => ({ spawn: spawnMock }));
    const { sshExec } = await import("../sshTool.js");

    // Password path routes through ssh2 for real (not spawn), so point it at an
    // unreachable local port for a fast, deterministic ECONNREFUSED rather than a real
    // network attempt.
    await sshExec({ host: "127.0.0.1", port: 1, user: "deploy", password: "supersecret" }, "uptime");

    // With a password set, sshExec should route through ssh2 (no spawn at all) — so spawn
    // should NOT have been called in this case.
    expect(spawnMock).not.toHaveBeenCalled();
    vi.doUnmock("node:child_process");
    vi.resetModules();
  }, 10000);

  it("scpUpload builds scp args with -P, -i, and -r for a recursive directory upload", async () => {
    vi.resetModules();
    const spawnMock = vi.fn(() => {
      const child = makeFakeChild();
      queueMicrotask(() => child.emit("close", 0));
      return child;
    });
    vi.doMock("node:child_process", () => ({ spawn: spawnMock }));
    const { scpUpload } = await import("../sshTool.js");

    await scpUpload({ host: "h", user: "u", port: 2200, keyPath: "/k" }, "/local/dir", "/remote/dir", true);

    expect(spawnMock).toHaveBeenCalledTimes(1);
    const [cmd, args] = spawnMock.mock.calls[0] as unknown as [string, string[]];
    expect(cmd).toBe("scp");
    expect(args).toEqual(
      expect.arrayContaining(["-P", "2200", "-i", "/k", "-r", "/local/dir", "u@h:/remote/dir"])
    );
    vi.doUnmock("node:child_process");
    vi.resetModules();
  });
});

// ─── scheduleTool.ts (mocked node:child_process — no real crontab in CI) ──────────────

describe("scheduleTool", () => {
  function makeFakeChild() {
    const child: any = new EventEmitter();
    child.stdin = { write: vi.fn(), end: vi.fn() };
    return child;
  }

  async function loadWithCrontabState(initialCrontab: string) {
    vi.resetModules();
    let currentCrontab = initialCrontab;
    const execFileMock = vi.fn((cmd: string, cmdArgs: string[], cb: (err: Error | null, res: { stdout: string; stderr: string }) => void) => {
      if (cmd === "crontab" && cmdArgs[0] === "-l") {
        if (currentCrontab === "__NO_CRONTAB__") {
          cb(new Error("no crontab for user"), { stdout: "", stderr: "" });
        } else {
          cb(null, { stdout: currentCrontab, stderr: "" });
        }
      }
    });
    const spawnMock = vi.fn((cmd: string) => {
      const child = makeFakeChild();
      if (cmd === "crontab") {
        // Capture the written content as the new crontab, then report success.
        const originalWrite = child.stdin.write;
        child.stdin.write = (content: string) => {
          currentCrontab = content;
          return originalWrite(content);
        };
        queueMicrotask(() => child.emit("close", 0));
      }
      return child;
    });
    vi.doMock("node:child_process", () => ({ spawn: spawnMock, execFile: execFileMock }));
    const mod = await import("../scheduleTool.js");
    return { ...mod, spawnMock, execFileMock, getCrontab: () => currentCrontab };
  }

  afterEach(() => {
    vi.doUnmock("node:child_process");
    vi.resetModules();
  });

  it("scheduleCron appends a marked entry to an empty crontab", async () => {
    const { scheduleCron, getCrontab } = await loadWithCrontabState("__NO_CRONTAB__");
    const result = await scheduleCron("job1", "0 * * * *", "echo hi");
    expect(result).toEqual({ id: "job1", cronExpr: "0 * * * *" });
    expect(getCrontab()).toContain("# xcoder-schedule:job1");
    expect(getCrontab()).toContain("0 * * * * echo hi");
  });

  it("scheduleCron appends to an existing non-empty crontab without clobbering it", async () => {
    const { scheduleCron, getCrontab } = await loadWithCrontabState("*/5 * * * * existing-job\n");
    await scheduleCron("job2", "0 0 * * *", "backup.sh");
    expect(getCrontab()).toContain("existing-job");
    expect(getCrontab()).toContain("# xcoder-schedule:job2");
  });

  it("listScheduled parses previously scheduled jobs back out", async () => {
    const { listScheduled } = await loadWithCrontabState(
      "# xcoder-schedule:job1\n0 * * * * echo hi\n# xcoder-schedule:job2\n0 0 * * * backup.sh\n"
    );
    const jobs = await listScheduled();
    expect(jobs).toEqual([
      { id: "job1", cronExpr: "0 * * * *", command: "echo hi" },
      { id: "job2", cronExpr: "0 0 * * *", command: "backup.sh" },
    ]);
  });

  it("listScheduled returns an empty array when there is no crontab", async () => {
    const { listScheduled } = await loadWithCrontabState("__NO_CRONTAB__");
    expect(await listScheduled()).toEqual([]);
  });

  it("removeScheduled removes the marker line and its job line, reports removed:true", async () => {
    const { removeScheduled, getCrontab } = await loadWithCrontabState(
      "# xcoder-schedule:job1\n0 * * * * echo hi\n# xcoder-schedule:job2\n0 0 * * * backup.sh\n"
    );
    const result = await removeScheduled("job1");
    expect(result).toEqual({ removed: true });
    expect(getCrontab()).not.toContain("job1");
    expect(getCrontab()).toContain("job2");
  });

  it("removeScheduled reports removed:false for an unknown id and leaves the crontab untouched", async () => {
    const { removeScheduled, getCrontab } = await loadWithCrontabState("# xcoder-schedule:job1\n0 * * * * echo hi\n");
    const result = await removeScheduled("does-not-exist");
    expect(result).toEqual({ removed: false });
    expect(getCrontab()).toContain("job1");
  });

  it("scheduleOnce computes the correct scheduledFor timestamp and detaches the child", async () => {
    vi.resetModules();
    const unrefMock = vi.fn();
    const spawnMock = vi.fn(() => ({ unref: unrefMock }));
    vi.doMock("node:child_process", () => ({ spawn: spawnMock, execFile: vi.fn() }));
    const { scheduleOnce } = await import("../scheduleTool.js");

    const before = Date.now();
    const result = await scheduleOnce(60, "echo done");
    const scheduledForMs = new Date(result.scheduledFor).getTime();

    expect(scheduledForMs).toBeGreaterThanOrEqual(before + 60_000 - 100);
    expect(scheduledForMs).toBeLessThanOrEqual(Date.now() + 60_000 + 100);
    expect(spawnMock).toHaveBeenCalledWith("bash", ["-c", "sleep 60 && echo done"], expect.objectContaining({ detached: true }));
    expect(unrefMock).toHaveBeenCalled();
  });
});

// ─── dockerComposeDeployTool.ts (real spawn, no docker binary in CI) ──────────────────

describe("dockerComposeDeployTool.dockerComposeUp", () => {
  it("resolves with a non-zero-ish result instead of throwing when the docker binary is missing", async () => {
    const { dockerComposeUp } = await import("../dockerComposeDeployTool.js");
    const result = await dockerComposeUp(tmpDir);
    // "docker" isn't installed in this environment, so the shell itself reports the
    // command as not found (exit 127) rather than the tool's own spawn 'error' handler
    // firing, since shell:true delegates command resolution to the shell.
    expect(result.exitCode).not.toBe(0);
    expect(typeof result.stderr).toBe("string");
  }, 15000);

  it("defaults projectDir to the given cwd when omitted", async () => {
    const { dockerComposeUp } = await import("../dockerComposeDeployTool.js");
    const result = await dockerComposeUp(undefined, tmpDir);
    expect(result.exitCode).not.toBe(0);
  }, 15000);
});

// ─── sshCopyTool.ts / sshRunCommandTool.ts (real connect(), closed local ports) ───────

function unreachableConfig(count: number): RemoteConfig {
  const targets = Array.from({ length: count }, (_, i) => ({ host: "127.0.0.1", port: i + 1 }));
  return { targets, auth: { user: "nobody", password: "x" } };
}

describe("sshCopyTool.sshCopy", () => {
  it("throws when the local path doesn't exist", async () => {
    const { sshCopy } = await import("../sshCopyTool.js");
    await expect(sshCopy(unreachableConfig(1), tmpDir, { localPath: "nope.txt", remotePath: "/r/nope.txt" })).rejects.toThrow(
      /does not exist/
    );
  });

  it("throws when an explicit target isn't in the configured fleet", async () => {
    fs.writeFileSync(path.join(tmpDir, "f.txt"), "x");
    const { sshCopy } = await import("../sshCopyTool.js");
    await expect(
      sshCopy(unreachableConfig(1), tmpDir, { localPath: "f.txt", remotePath: "/r/f.txt", target: "not-configured-host" })
    ).rejects.toThrow(/not one of the configured targets/);
  });

  it("fans out to every configured target and isolates per-target failures (none throw the whole call)", async () => {
    fs.writeFileSync(path.join(tmpDir, "f.txt"), "x");
    const { sshCopy } = await import("../sshCopyTool.js");
    const result = await sshCopy(unreachableConfig(2), tmpDir, { localPath: "f.txt", remotePath: "/r/f.txt" });
    expect(result.ok).toBe(false);
    expect(result.results).toHaveLength(2);
    expect(result.results.every((r) => r.ok === false)).toBe(true);
    expect(result.results.map((r) => r.target).sort()).toEqual(["127.0.0.1:1", "127.0.0.1:2"]);
  }, 15000);

  it("filters to a single target by host:port", async () => {
    fs.writeFileSync(path.join(tmpDir, "f.txt"), "x");
    const { sshCopy } = await import("../sshCopyTool.js");
    const result = await sshCopy(unreachableConfig(2), tmpDir, { localPath: "f.txt", remotePath: "/r/f.txt", target: "127.0.0.1:1" });
    expect(result.results).toHaveLength(1);
    expect(result.results[0].target).toBe("127.0.0.1:1");
  }, 10000);
});

describe("sshRunCommandTool.sshRunCommand", () => {
  it("throws when an explicit target isn't in the configured fleet", async () => {
    const { sshRunCommand } = await import("../sshRunCommandTool.js");
    await expect(sshRunCommand(unreachableConfig(1), { command: "uptime", target: "ghost-host" })).rejects.toThrow(
      /not one of the configured targets/
    );
  });

  it("fans out to every target in parallel and isolates per-target connection failures", async () => {
    const { sshRunCommand } = await import("../sshRunCommandTool.js");
    const result = await sshRunCommand(unreachableConfig(3), { command: "uptime" });
    expect(result.ok).toBe(false);
    expect(result.results).toHaveLength(3);
    for (const r of result.results) {
      expect(r.ok).toBe(false);
      expect(r.exitCode).toBeNull();
      expect(r.stderr.length).toBeGreaterThan(0);
    }
  }, 15000);

  it("treats a multi-line command as a script (detected by newline) without crashing the dispatch", async () => {
    const { sshRunCommand } = await import("../sshRunCommandTool.js");
    const result = await sshRunCommand(unreachableConfig(1), { command: "echo one\necho two" });
    expect(result.results).toHaveLength(1);
    expect(result.ok).toBe(false);
  }, 10000);
});
