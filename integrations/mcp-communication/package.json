{
  "name": "mcp-communication",
  "version": "0.1.0",
  "description": "MCP server exposing Gmail, Google Drive, Google Calendar, GitHub, Telegram and WhatsApp as tools over stdio.",
  "type": "module",
  "bin": { "mcp-communication": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": { "node": ">=18" }
}
