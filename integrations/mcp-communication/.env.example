# mcp-communication — copy to .env and fill in only the providers you want enabled.
# Unconfigured providers are simply not offered as tools. See README.md for how to obtain each.

# --- Google: Gmail + Drive + Calendar (one credential set, three APIs) ---
# Enable the Gmail, Drive and Calendar APIs in Google Cloud Console, create a Desktop-app
# OAuth client, then complete the consent flow once to get a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- GitHub ---
# Classic token: `repo` (or `public_repo`). Fine-grained: Contents=Read, Issues=RW, Metadata=Read.
GITHUB_TOKEN=

# --- Telegram ---
# From @BotFather. Receiving works via polling — no webhook needed.
TELEGRAM_BOT_TOKEN=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Receiving WhatsApp requires a public webhook — Meta has no polling endpoint.
# Only needed if you want whatsapp_receive to return anything; requires a long-lived process.
WHATSAPP_WEBHOOK_PORT=
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: without it, inbound payloads are NOT signature-verified, so anyone who
# finds the webhook URL can inject messages a model will read and act on.
WHATSAPP_APP_SECRET=
