# Copy to .env.  Default is offline mock mode (no key needed) so you can see the whole pipeline run.
LLM_MODE=mock                 # mock | anthropic
ANTHROPIC_API_KEY=            # required when LLM_MODE=anthropic
SANDBOX_TOKEN=change-me-sandbox-token

# Evolution: which candidate changes need a human click before promotion: never | prompts | always
EVOLVE_APPROVAL=prompts
# Minimum score gain required to promote (default: 0 in mock mode, 0.02 with a real LLM)
EVOLVE_EPSILON=
# Autonomous goal loop: measure KPIs and try to improve the weakest one every N minutes (0 = off, costs tokens)
# Deprecated and ignored. Autonomous mode is now controlled from the UI (AGI > Schedule) with a daily token allowance.
GOAL_LOOP_MINUTES=0
# Seconds a newly promoted release has to pass smoke evals before it is rolled back
PROBATION_SECONDS=90

# xcoder integration: shared secret between xcoder's API and this service (generate a long random value).
# When set, every AGI API route except /healthz requires it. xcoder reads the same value as XCODER_AGI_TOKEN.
AGI_API_TOKEN=
